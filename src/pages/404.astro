---
// GitHub Pages shows this for any address on the site that doesn't exist.
import Base from '../layouts/Base.astro';
import ErrorPage from '../components/ErrorPage.astro';
import profile from '../data/profile.json';
import { getProjects, projectUrl } from '../lib/projects.js';
import { url } from '../lib/url.js';

const projects = await getProjects();
const links = [
  ...projects.filter((p) => p.data.featured).map((p) => ({ href: projectUrl(p), label: p.data.title })),
  { href: url('projects/'), label: 'Projects' },
  { href: url('about/'), label: 'About me' },
  { href: url('#contact'), label: 'Contact' },
];
---
<Base title={`Page not found · ${profile.name}`} description="This page doesn’t exist." noindex bare>
  <ErrorPage heading="Wrong stop." text="This page isn’t on the route. It may have moved, or the link has a small typo." links={links} />
</Base>
