---
// GitHub Pages shows this for any address on the site that doesn't exist.
import Base from '../layouts/Base.astro';
import ErrorPage from '../components/ErrorPage.astro';
import profile from '../data/profile.json';
import { getProjects, projectUrl } from '../lib/projects.js';
import { url } from '../lib/url.js';

const projects = await getProjects();
const links = [
  ...projects.filter((p) => p.data.featured).map((p) => ({ href: projectUrl(p), label: p.data.title })),
  { href: url('projects/'), label: 'All projects' },
  { href: url('about/'), label: 'About me' },
  { href: url('#contact'), label: 'Contact' },
];
---
<Base title={`Page not found · ${profile.name}`} description="This page doesn’t exist." noindex bare>
  <ErrorPage heading="I can’t find that page" text="It may have moved, or the link has a small typo." links={links}>
    <svg slot="icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /><path d="M9.3 9.2a1.8 1.8 0 1 1 2.6 1.6c-.6.3-.9.8-.9 1.3" /><path d="M11 14.4h.01" /></svg>
  </ErrorPage>
</Base>
