---
// The About page. Its text is src/content/pages/about.md (editable in the admin under "About page").
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import AstroLogo from '../components/AstroLogo.astro';
import { faArrowRight, faDownload } from '@fortawesome/free-solid-svg-icons';
import photo from '../images/profile.jpg';
import profile from '../data/profile.json';
import { socialIcon } from '../lib/socials.js';
import { url, absolute } from '../lib/url.js';
import { graph, person, breadcrumbs, personId } from '../lib/schema.js';

const page = await getEntry('pages', 'about');
const { Content } = await render(page);
const { area, city, country } = profile.location;
const title = `About ${profile.name} · ${profile.role} in ${city}`;

const schema = graph(await person(), breadcrumbs([['Home', ''], ['About', 'about/']]), {
  '@type': 'AboutPage',
  url: absolute('about/'),
  name: title,
  mainEntity: { '@id': personId() },
});

const colophon = [
  ['Astro', 'Every page is plain HTML built ahead of time. The only JavaScript is the theme switch, the phone menu and the contact form.'],
  ['Content collections', 'Each project is a Markdown file with a screenshot next to it. Astro checks every file when it builds, so a mistake stops the update instead of breaking the live site.'],
  ['Image optimisation', 'Screenshots are resized and converted to WebP at build time: a 6 MB screenshot ships as about 50 KB.'],
  ['Sveltia CMS', 'The admin page edits those same files and saves them straight to GitHub. No database, no server to pay for.'],
  ['GitHub Actions and Pages', 'Every change rebuilds the site and publishes it in about a minute, for free.'],
  ['Satoshi and JetBrains Mono', 'Downloaded by Astro when it builds and served from this site, so no font is fetched from Google on every visit.'],
];
---
<Base title={title} description={page.data.description} schema={schema}>
  <section class="section intro">
    <div class="container layout">
      <div class="photo">
        <Image src={photo} alt={`${profile.name}`} widths={[320, 640, 960]} sizes="(max-width: 820px) 70vw, 380px" loading="eager" />
      </div>
      <div>
        <span class="index mono">About</span>
        <h1>{page.data.title}</h1>
        <p class="who">
          {profile.fullName || profile.name}. {profile.role} in {[area, city, country].filter(Boolean).join(', ')}.
        </p>
        <div class="prose">
          <Content />
        </div>
        <ul class="socials">
          {profile.socials.map((social) => (
            <li><a href={social.url} target="_blank" rel="noopener me"><Icon icon={socialIcon(social.network)} /> {social.label}</a></li>
          ))}
        </ul>
        <div class="cta">
          <a class="btn btn-primary" href={url('#contact')}>Work with me <Icon icon={faArrowRight} /></a>
          <a class="btn btn-ghost" href={url(profile.cv)} download>Download CV <Icon icon={faDownload} /></a>
        </div>
      </div>
    </div>
  </section>

  {page.data.spotify && (
    <section class="section music" aria-labelledby="music-title">
      <div class="container narrow">
        <h2 id="music-title" class="small-title mono">On repeat while I code</h2>
        <iframe
          src={page.data.spotify}
          title="Spotify playlist"
          width="100%"
          height="352"
          loading="lazy"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        ></iframe>
      </div>
    </section>
  )}

  <section class="section" id="colophon" aria-labelledby="colophon-title">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="index">Colophon</span>
          <h2 id="colophon-title" class="built"><AstroLogo /> How this site is built</h2>
          <p>A fast static site I update from the browser, with nothing to pay for and no server to look after.</p>
        </div>
      </div>
      <dl class="colophon">
        {colophon.map(([name, text]) => (
          <div><dt>{name}</dt><dd>{text}</dd></div>
        ))}
      </dl>
    </div>
  </section>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .photo {
    position: sticky;
    top: 6rem;
  }

  .photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: calc(var(--radius) + 8px);
    box-shadow: var(--shadow);
  }

  .index {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--link);
    font-size: 0.82rem;
  }

  h1 {
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    letter-spacing: -0.05em;
  }

  .who {
    margin: 1rem 0 2rem;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2.25rem;
    list-style: none;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
  }

  .socials a:hover {
    border-color: var(--ink);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .narrow {
    max-width: 760px;
  }

  .small-title {
    margin-bottom: 1.2rem;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  iframe {
    border: 0;
    border-radius: 14px;
  }

  .built {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .built :global(.astro-logo) {
    width: 0.62em;
    height: auto;
  }

  .colophon {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
    margin: 0;
  }

  .colophon div {
    padding: 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  dt {
    font-weight: 700;
    font-size: 1.05rem;
  }

  dd {
    margin: 0.5rem 0 0;
    color: var(--ink-2);
    font-size: 0.97rem;
  }

  @media (max-width: 820px) {
    .layout {
      grid-template-columns: 1fr;
    }

    .photo {
      position: static;
      max-width: 22rem;
    }
  }
</style>
