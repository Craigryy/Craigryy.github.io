---
// The About page. Its text is src/content/pages/about.md (editable in the admin under "About page").
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Clover from '../components/Clover.astro';
import AstroLogo from '../components/AstroLogo.astro';
import { faArrowRight, faDownload } from '@fortawesome/free-solid-svg-icons';
import photo from '../images/profile.jpg';
import profile from '../data/profile.json';
import { socialIcon } from '../lib/socials.js';
import { url, absolute } from '../lib/url.js';
import { graph, person, breadcrumbs, personId } from '../lib/schema.js';

const page = await getEntry('pages', 'about');
const { Content } = await render(page);
const title = `About ${profile.name} · ${profile.role} in ${profile.location.city}`;

const schema = graph(await person(), breadcrumbs([['Home', ''], ['About', 'about/']]), {
  '@type': 'AboutPage',
  url: absolute('about/'),
  name: title,
  mainEntity: { '@id': personId() },
});

const colophon = [
  ['Astro', 'Every page is plain HTML built ahead of time. The only JavaScript is the route board, the colour switch, the phone menu and the contact form.'],
  ['Content collections', 'Each project is a Markdown file with its screenshots next to it. Astro checks every file when it builds, so a mistake stops the update instead of breaking the live site.'],
  ['Image optimisation', 'Screenshots are resized and converted to WebP at build time: a 6 MB screenshot ships as about 50 KB.'],
  ['Sveltia CMS', 'The admin page edits those same files and saves them straight to GitHub. No database, no server to pay for.'],
  ['GitHub Actions and Pages', 'Every change rebuilds the site and publishes it in about a minute, for free.'],
  ['Bricolage Grotesque', 'One variable typeface for everything: heavy for headings, narrow for labels, regular for reading. Served from this site, so no font is fetched from Google on every visit.'],
];
---
<Base title={title} description={page.data.description} schema={schema} stop="about">
  <section class="section intro">
    <div class="container layout">
      <figure class="window portrait">
        <Image src={photo} alt={`${profile.name}`} widths={[320, 640, 960]} sizes="(max-width: 820px) 70vw, 380px" loading="eager" />
        <Clover class="decal" size="3rem" outline />
      </figure>
      <div>
        <h1 class="paint">{page.data.title}</h1>
        <p class="who">
          {profile.fullName || profile.name}. {profile.role}.
        </p>
        <div class="board story">
          <div class="prose">
            <Content />
          </div>
        </div>
        <ul class="socials">
          {profile.socials.map((social) => (
            <li><a href={social.url} target="_blank" rel="noopener me"><Icon icon={socialIcon(social.network)} /> {social.label}</a></li>
          ))}
        </ul>
        <div class="cta">
          <a class="btn" href={url('#contact')}>Work with me <Icon icon={faArrowRight} /></a>
          <a class="btn btn-line" href={url(profile.cv)} download><Icon icon={faDownload} /> Download CV</a>
        </div>
      </div>
    </div>
  </section>

  {page.data.spotify && (
    <section class="section music" aria-labelledby="music-title">
      <div class="container narrow">
        <h2 id="music-title" class="paint">On repeat while I code</h2>
        <div class="window player">
          <iframe
            src={page.data.spotify}
            title="Spotify playlist"
            width="100%"
            height="352"
            loading="lazy"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          ></iframe>
        </div>
      </div>
    </section>
  )}

  <section class="section" id="colophon" aria-labelledby="colophon-title">
    <div class="container">
      <div class="section-sign">
        <div>
          <h2 id="colophon-title" class="paint built"><AstroLogo /> How this site is built</h2>
          <p>A fast static site I update from the browser, with nothing to pay for and no server to look after.</p>
        </div>
      </div>
      <dl class="board colophon">
        {colophon.map(([name, text]) => (
          <div><dt>{name}</dt><dd>{text}</dd></div>
        ))}
      </dl>
    </div>
  </section>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: start;
  }

  .portrait {
    position: sticky;
    top: 6.5rem;
    margin: 0;
    padding: 0.65rem;
    border-radius: 24px;
    overflow: visible;
  }

  .portrait img {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 16px;
  }

  .portrait :global(.decal) {
    position: absolute;
    top: -1.1rem;
    right: -0.9rem;
    color: var(--clover);
    transform: rotate(12deg);
  }

  h1 {
    font-size: clamp(2.8rem, 7vw, 4.8rem);
  }

  .who {
    margin: 1.1rem 0 1.8rem;
    font-size: 1.15rem;
    font-weight: 700;
  }

  .story {
    padding: clamp(1.5rem, 4vw, 2.4rem) clamp(1.25rem, 4vw, 2.5rem);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
    list-style: none;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    border: 2px solid var(--ground-ink);
    border-radius: var(--radius);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
  }

  .socials a:hover {
    background: var(--ground-ink);
    color: var(--ground);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .narrow {
    max-width: 760px;
  }

  .music h2 {
    margin-bottom: 1.3rem;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .player {
    padding: 0.5rem;
  }

  iframe {
    border: 0;
    border-radius: 12px;
  }

  .built {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .built :global(.astro-logo) {
    width: 0.62em;
    height: auto;
  }

  .colophon {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
  }

  @media (max-width: 960px) {
    .colophon {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .colophon {
      grid-template-columns: 1fr;
    }
  }

  .colophon div {
    padding: 1.5rem 1.6rem;
    border-bottom: 2px solid var(--board-rule);
  }

  dt {
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: 1.1rem;
  }

  dd {
    margin: 0.5rem 0 0;
    color: var(--board-muted);
    font-size: 0.98rem;
  }

  @media (max-width: 820px) {
    .layout {
      grid-template-columns: 1fr;
    }

    .portrait {
      position: relative;
      top: 0;
      max-width: 19rem;
    }
  }
</style>
