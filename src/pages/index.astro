---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Timetable from '../components/Timetable.astro';
import Stack from '../components/Stack.astro';
import Journey from '../components/Journey.astro';
import Writing from '../components/Writing.astro';
import Contact from '../components/Contact.astro';
import AnimePanel from '../components/AnimePanel.astro';
import Icon from '../components/Icon.astro';
import { faArrowRight } from '@fortawesome/free-solid-svg-icons';
import profile from '../data/profile.json';
import { getProjects, titlesOf } from '../lib/projects.js';
import { url, absolute } from '../lib/url.js';
import { graph, person, website, websiteId, personId, projectThing } from '../lib/schema.js';

// Every folder in src/content/projects/ is a project. "featured" ones become the big stops; the rest the timetable.
const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured);
const titles = titlesOf(projects);

const schema = graph(
  await person(),
  website(),
  {
    '@type': 'ProfilePage',
    '@id': absolute('#webpage'),
    url: absolute(),
    name: profile.seo.title,
    description: profile.seo.description,
    isPartOf: { '@id': websiteId() },
    mainEntity: { '@id': personId() },
    about: { '@id': personId() },
  },
  projects.map(projectThing),
);
---
<Base schema={schema}>
  <Hero projects={projects} />

  <section class="section" id="work" data-stop="work" aria-labelledby="work-title">
    <div class="container">
      <div class="section-sign">
        <div>
          <h2 id="work-title" class="paint">Things I’ve shipped</h2>
          <p>Live products, and the side projects that taught me how to build them.</p>
        </div>
        <a class="text-link" href={url('projects/')}>More projects <Icon icon={faArrowRight} /></a>
      </div>
      <ol class="featured">
        {featured.map((project, index) => (
          <li><ProjectCard project={project} flip={index % 2 === 1} eager={index === 0} /></li>
        ))}
      </ol>
      {others.length > 0 && (
        <div class="more">
          <h3>More projects</h3>
          <Timetable projects={others} caption="More projects" />
        </div>
      )}
    </div>
  </section>

  <Stack />
  <Journey titles={titles} />
  <Writing />
  <AnimePanel />
  <Contact />
</Base>

<style>
  #work {
    padding-top: clamp(3.5rem, 7vw, 5.5rem);
  }

  .featured {
    display: grid;
    gap: clamp(3rem, 7vw, 5rem);
    list-style: none;
  }

  .more {
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
  }

  .more h3 {
    margin-bottom: 1rem;
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    font-weight: 800;
    letter-spacing: -0.025em;
  }
</style>
