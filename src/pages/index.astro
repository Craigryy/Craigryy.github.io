---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Stack from '../components/Stack.astro';
import Journey from '../components/Journey.astro';
import Writing from '../components/Writing.astro';
import Contact from '../components/Contact.astro';
import profile from '../data/profile.json';
import { getProjects, titlesOf } from '../lib/projects.js';
import { url, absolute } from '../lib/url.js';
import { graph, person, website, websiteId, personId, projectThing } from '../lib/schema.js';

// Every folder in src/content/projects/ is a project. "featured" ones get the big cards.
const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured);
const titles = titlesOf(projects);

const schema = graph(
  await person(),
  website(),
  {
    '@type': 'ProfilePage',
    '@id': absolute('#webpage'),
    url: absolute(),
    name: profile.seo.title,
    description: profile.seo.description,
    isPartOf: { '@id': websiteId() },
    mainEntity: { '@id': personId() },
    about: { '@id': personId() },
  },
  projects.map(projectThing),
);
---
<Base schema={schema}>
  <Hero projects={projects} />

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="index">01 / Work</span>
          <h2 id="work-title">Things I’ve built</h2>
          <p>Products I founded, platforms I maintain and side projects that taught me something.</p>
        </div>
        <a class="text-link" href={url('projects/')}>All {projects.length} projects →</a>
      </div>
      <div class="featured">
        {featured.map((project, index) => <ProjectCard project={project} featured eager={index === 0} />)}
      </div>
      {others.length > 0 && (
        <div class="grid">
          {others.map((project) => <ProjectCard project={project} />)}
        </div>
      )}
    </div>
  </section>

  <Stack />
  <Journey titles={titles} />
  <Writing />
  <Contact />
</Base>

<style>
  /* The hero already ends with plenty of space. */
  #work {
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .featured {
    display: grid;
    gap: 1.25rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: 1.25rem;
    margin-top: 1.25rem;
  }
</style>
