---
// One page per project: /projects/<name>/. The write-up on the signboard is the project's Markdown.
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { faArrowLeft, faArrowRight, faArrowUpRightFromSquare } from '@fortawesome/free-solid-svg-icons';
import { faGithub } from '@fortawesome/free-brands-svg-icons';
import profile from '../../data/profile.json';
import { getProjects, slugOf, projectUrl, projectPath, coverName, titleOf, roleLabel } from '../../lib/projects.js';
import { url as siteUrl, absolute } from '../../lib/url.js';
import { graph, person, projectThing, breadcrumbs } from '../../lib/schema.js';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: slugOf(project) },
    props: { project, next: projects.length > 1 ? projects[(index + 1) % projects.length] : null },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const { title, tagline, role, year, url, repo, image, alt, stack, gallery } = project.data;
const roleText = roleLabel(role) && titleOf(project);

// Link previews (WhatsApp, LinkedIn, X) and Google get a 1200×630 crop of the screenshot.
const share = image && (await getImage({ src: image, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpg' }));
const pageTitle = `${title} · ${profile.name}, ${profile.role.toLowerCase()} in ${profile.location.city}`;
const builtWith = stack.length ? ` Built with ${stack.slice(0, 5).join(', ')}.` : '';
const description = `${roleText ? `${roleText}: ` : ''}${tagline}.${builtWith}`.replace(/\.\./g, '.').slice(0, 300);

const schema = graph(
  await person(),
  { ...projectThing(project), mainEntityOfPage: absolute(projectPath(project)), ...(share && { image: new URL(share.src, Astro.site).href }) },
  breadcrumbs([['Home', ''], ['Projects', 'projects/'], [title, projectPath(project)]]),
);
---
<Base title={pageTitle} description={description} image={share && new URL(share.src, Astro.site).href} imageAlt={alt || `${title} screenshot`} type="article" schema={schema} stop="work">
  <article>
    <header class="container head">
      <nav class="crumbs board-caps" aria-label="Breadcrumb">
        <a href={siteUrl()}>Home</a> <span aria-hidden="true">/</span> <a href={siteUrl('projects/')}>Projects</a> <span aria-hidden="true">/</span> <span aria-current="page">{title}</span>
      </nav>
      <h1 class="paint">{title}</h1>
      <p class="strip board-caps">
        <time class="nums" datetime={String(year)}>{year}</time>
        {roleText && <span>{roleText}</span>}
      </p>
      <p class="tagline">{tagline}</p>
      {(url || repo) && (
        <div class="actions">
          {url && <a class="btn" href={url} target="_blank" rel="noopener">Visit the live site <Icon icon={faArrowUpRightFromSquare} /></a>}
          {repo && <a class="btn btn-line" href={repo} target="_blank" rel="noopener"><Icon icon={faGithub} /> View the code</a>}
        </div>
      )}
    </header>

    <div class="container">
      <figure class="window cover" style={`view-transition-name: ${coverName(project)}`}>
        {image ? (
          <Image src={image} alt={alt || `${title} screenshot`} widths={[800, 1200, 1800]} sizes="(max-width: 1160px) 100vw, 1160px" loading="eager" fetchpriority="high" />
        ) : (
          <div class="no-shot paint-plain">{title}</div>
        )}
      </figure>
    </div>

    <div class="container body">
      <aside class="facts" aria-label="Project facts">
        <dl class="board">
          <div><dt class="board-caps">Year</dt><dd class="nums">{year}</dd></div>
          {roleLabel(role) && <div><dt class="board-caps">My role</dt><dd>{roleLabel(role)}</dd></div>}
          {stack.length > 0 && (
            <div>
              <dt class="board-caps">Built with</dt>
              <dd><ol class="route-line stacked">{stack.map((item) => <li>{item}</li>)}</ol></dd>
            </div>
          )}
          {(url || repo) && (
            <div>
              <dt class="board-caps">Links</dt>
              <dd class="links">
                {url && <a href={url} target="_blank" rel="noopener">{new URL(url).hostname.replace(/^www\./, '')} <Icon icon={faArrowUpRightFromSquare} /></a>}
                {repo && <a href={repo} target="_blank" rel="noopener">Source code <Icon icon={faArrowUpRightFromSquare} /></a>}
              </dd>
            </div>
          )}
        </dl>
      </aside>
      <div class="board writeup">
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>

    {gallery.length > 0 && (
      <section class="container screens" aria-labelledby="screens-title">
        <h2 id="screens-title" class="paint">Screens</h2>
        <div class="shots">
          {gallery.map((shot) => {
            const ratio = shot.image.width / shot.image.height;
            return (
              <figure class:list={{ portrait: ratio < 1 }} style={`flex: ${ratio.toFixed(3)} 1 0`}>
                <div class="window"><Image src={shot.image} alt={shot.caption || `${title} screenshot`} widths={[480, 960, 1600]} sizes="(max-width: 820px) 100vw, 900px" /></div>
                {shot.caption && <figcaption>{shot.caption}</figcaption>}
              </figure>
            );
          })}
        </div>
      </section>
    )}

    <footer class="container more">
      <a class="text-link" href={siteUrl('projects/')}><Icon icon={faArrowLeft} /> More projects</a>
      {next && (
        <a class="next" href={projectUrl(next)}>
          <strong class="paint">Next stop: {next.data.title} <Icon icon={faArrowRight} /></strong>
        </a>
      )}
    </footer>
  </article>
</Base>

<style>
  .head {
    padding-top: clamp(2rem, 5vw, 3.5rem);
  }

  .crumbs {
    color: var(--ground-muted);
    font-size: 0.78rem;
  }

  .crumbs a {
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--ground-ink);
    text-decoration: underline;
  }

  h1 {
    margin-top: 1.6rem;
    font-size: clamp(2.8rem, 8vw, 5.4rem);
  }

  .strip {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    margin-top: 1.5rem;
    padding: 0.55rem 1rem;
    background: var(--band);
    color: var(--band-ink);
  }

  .tagline {
    max-width: 42rem;
    margin-top: 1.1rem;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 600;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .cover {
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    padding: 0.7rem;
    border-radius: 24px;
  }

  .cover img {
    border-radius: 15px;
  }

  .no-shot {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 7;
    color: var(--route-lit);
    font-size: clamp(1.6rem, 4vw, 2.6rem);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .facts dl {
    position: sticky;
    top: 6rem;
    display: grid;
    gap: 1.3rem;
    margin: 0;
    padding: 1.5rem 1.4rem;
  }

  dt {
    margin-bottom: 0.4rem;
    color: var(--board-muted);
    font-size: 0.74rem;
  }

  dd {
    margin: 0;
    font-weight: 600;
  }

  .route-line.stacked {
    font-size: 0.84rem;
  }

  .links {
    display: grid;
    gap: 0.35rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .links a:hover {
    text-decoration-color: var(--shade);
  }

  .links :global(svg) {
    font-size: 0.75em;
  }

  .writeup {
    padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1.25rem, 4vw, 2.75rem);
  }

  /* Screenshots side by side at the same height: each one's width follows its shape (flex grow = width / height). */
  .screens {
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .screens h2 {
    margin-bottom: 1.4rem;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .shots {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .shots figure {
    min-width: 0;
    margin: 0;
  }

  .shots .portrait .window {
    border-radius: 30px;
  }

  .shots .portrait img {
    border-radius: 22px;
  }

  figcaption {
    margin-top: 0.7rem;
    color: var(--ground-muted);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 2rem clamp(3rem, 8vw, 5rem);
    border-top: var(--stripe) solid var(--band);
  }

  .next {
    display: grid;
    justify-items: end;
    gap: 0.35rem;
    text-decoration: none;
  }

  .next strong {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
  }

  .next strong :global(svg) {
    font-size: 0.7em;
  }

  .next:hover strong {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 820px) {
    .body {
      grid-template-columns: 1fr;
    }

    .facts dl {
      position: relative;
      top: 0;
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    }

    .facts dl > div:has(.route-line) {
      grid-column: 1 / -1;
    }

    .shots {
      flex-direction: column;
    }

    .shots figure {
      flex: none !important;
      width: 100%;
    }

    .shots .portrait {
      width: min(100%, 20rem);
      margin-inline: auto;
    }
  }
</style>
