---
// One page per project: /projects/<name>/. The text under the screenshot is the project's Markdown.
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { faArrowLeft, faArrowRight, faArrowUpRightFromSquare } from '@fortawesome/free-solid-svg-icons';
import { faGithub } from '@fortawesome/free-brands-svg-icons';
import profile from '../../data/profile.json';
import { getProjects, slugOf, projectUrl, projectPath, coverName } from '../../lib/projects.js';
import { url as siteUrl, absolute } from '../../lib/url.js';
import { graph, person, projectThing, breadcrumbs } from '../../lib/schema.js';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: slugOf(project) },
    props: { project, next: projects.length > 1 ? projects[(index + 1) % projects.length] : null },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const { title, tagline, role, year, url, repo, image, alt, stack, gallery } = project.data;

// Link previews (WhatsApp, LinkedIn, X) and Google get a 1200×630 crop of the screenshot.
const share = image && (await getImage({ src: image, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpg' }));
const pageTitle = `${title} · ${profile.name}, ${profile.role.toLowerCase()} in ${profile.location.city}`;
const builtWith = stack.length ? ` Built with ${stack.slice(0, 5).join(', ')}.` : '';
const description = `${role ? `${role} of ${title}: ` : ''}${tagline}.${builtWith}`.replace(/\.\./g, '.').slice(0, 300);

const schema = graph(
  await person(),
  { ...projectThing(project), mainEntityOfPage: absolute(projectPath(project)), ...(share && { image: new URL(share.src, Astro.site).href }) },
  breadcrumbs([['Home', ''], ['Projects', 'projects/'], [title, projectPath(project)]]),
);
---
<Base title={pageTitle} description={description} image={share && new URL(share.src, Astro.site).href} imageAlt={alt || `${title} screenshot`} type="article" schema={schema}>
  <article>
    <header class="container head">
      <nav class="crumbs mono" aria-label="Breadcrumb">
        <a href={siteUrl()}>Home</a> / <a href={siteUrl('projects/')}>Projects</a> / <span aria-current="page">{title}</span>
      </nav>
      <p class="meta mono">
        <span>{year}</span>
        {role && <span class="sticker" style="--tilt: -3deg"><span class="story story-green role">{role}</span></span>}
      </p>
      <h1>{title}</h1>
      <p class="tagline">{tagline}</p>
      {(url || repo) && (
        <div class="actions">
          {url && <a class="btn btn-primary" href={url} target="_blank" rel="noopener">Visit the live site <Icon icon={faArrowUpRightFromSquare} /></a>}
          {repo && <a class="btn btn-ghost" href={repo} target="_blank" rel="noopener"><Icon icon={faGithub} /> View the code</a>}
        </div>
      )}
    </header>

    <div class="container">
      <figure class="cover" style={`view-transition-name: ${coverName(project)}`}>
        {image ? (
          <Image src={image} alt={alt || `${title} screenshot`} widths={[800, 1200, 1800]} sizes="(max-width: 1120px) 100vw, 1120px" loading="eager" fetchpriority="high" />
        ) : (
          <div class="placeholder"><span class="mono">{title}</span></div>
        )}
      </figure>
    </div>

    <div class="container body">
      <aside class="facts" aria-label="Project facts">
        <dl>
          <div><dt>Year</dt><dd>{year}</dd></div>
          {role && <div><dt>My role</dt><dd>{role}</dd></div>}
          {stack.length > 0 && (
            <div>
              <dt>Built with</dt>
              <dd><ul class="chips">{stack.map((item) => <li class="chip">{item}</li>)}</ul></dd>
            </div>
          )}
          {(url || repo) && (
            <div>
              <dt>Links</dt>
              <dd class="links">
                {url && <a href={url} target="_blank" rel="noopener">{new URL(url).hostname.replace(/^www\./, '')} <Icon icon={faArrowUpRightFromSquare} /></a>}
                {repo && <a href={repo} target="_blank" rel="noopener">Source code <Icon icon={faArrowUpRightFromSquare} /></a>}
              </dd>
            </div>
          )}
        </dl>
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>

    {gallery.length > 0 && (
      <section class="container screens" aria-labelledby="screens-title">
        <h2 id="screens-title" class="mono">Screens</h2>
        <div class="shots">
          {gallery.map((shot) => {
            const ratio = shot.image.width / shot.image.height;
            return (
              <figure class:list={{ portrait: ratio < 1 }} style={`flex: ${ratio.toFixed(3)} 1 0`}>
                <Image src={shot.image} alt={shot.caption || `${title} screenshot`} widths={[480, 960, 1600]} sizes="(max-width: 820px) 100vw, 900px" />
                {shot.caption && <figcaption>{shot.caption}</figcaption>}
              </figure>
            );
          })}
        </div>
      </section>
    )}

    <footer class="container more">
      <a class="text-link" href={siteUrl('#work')}><Icon icon={faArrowLeft} /> All projects</a>
      {next && (
        <a class="next" href={projectUrl(next)}>
          <span class="mono">Next project</span>
          <strong>{next.data.title} <Icon icon={faArrowRight} /></strong>
        </a>
      )}
    </footer>
  </article>
</Base>

<style>
  .head {
    padding-top: clamp(2rem, 6vw, 4rem);
  }

  .crumbs {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .crumbs a {
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .role {
    font-size: 1rem;
  }

  h1 {
    margin-top: 0.8rem;
    font-size: clamp(2.8rem, 8vw, 5.2rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .tagline {
    max-width: 40rem;
    margin-top: 1rem;
    color: var(--ink-2);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .cover {
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 6px);
    background: var(--bg-2);
    box-shadow: var(--shadow);
  }

  .cover img {
    width: 100%;
  }

  .placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 7;
    background:
      radial-gradient(circle at 20% 20%, color-mix(in srgb, var(--accent) 55%, transparent), transparent 55%),
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 32px 32px;
  }

  .placeholder span {
    font-size: clamp(1.4rem, 4vw, 2.4rem);
  }

  .placeholder span::before {
    content: '> ';
    color: var(--link);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .facts dl {
    position: sticky;
    top: 6rem;
    display: grid;
    gap: 1.4rem;
    margin: 0;
  }

  dt {
    margin-bottom: 0.4rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  dd {
    margin: 0;
    font-weight: 500;
  }

  .links {
    display: grid;
    gap: 0.35rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--link);
    text-underline-offset: 3px;
  }

  .links :global(svg) {
    font-size: 0.75em;
  }

  /* Screenshots side by side at the same height: each one's width follows its shape (flex grow = width / height). */
  .screens {
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .screens h2 {
    margin-bottom: 1.2rem;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .shots {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .shots figure {
    min-width: 0;
    margin: 0;
  }

  .shots img {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .shots .portrait img {
    border-radius: calc(var(--radius) + 10px);
  }

  figcaption {
    margin-top: 0.7rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem clamp(3rem, 8vw, 5rem);
    border-top: 1px solid var(--line);
  }

  .next {
    display: grid;
    justify-items: end;
    gap: 0.2rem;
    text-decoration: none;
  }

  .next span {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .next strong {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    letter-spacing: -0.03em;
  }

  .next:hover strong {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  @media (max-width: 820px) {
    .body {
      grid-template-columns: 1fr;
    }

    .facts dl {
      position: static;
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    }

    .facts dl > div:has(.chips) {
      grid-column: 1 / -1;
    }

    .shots {
      flex-direction: column;
    }

    .shots figure {
      flex: none !important;
      width: 100%;
    }

    .shots .portrait {
      width: min(100%, 20rem);
      margin-inline: auto;
    }
  }
</style>
