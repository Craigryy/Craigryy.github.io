---
import Base from '../../layouts/Base.astro';
import Timetable from '../../components/Timetable.astro';
import profile from '../../data/profile.json';
import { getProjects, projectPath } from '../../lib/projects.js';
import { absolute } from '../../lib/url.js';
import { graph, person, breadcrumbs, personId } from '../../lib/schema.js';

const projects = await getProjects();
const { city, country } = profile.location;
const title = `Projects · ${profile.name}, ${profile.role.toLowerCase()} in ${city}`;
const description = `A selection of web apps and tools built by ${profile.name}, a ${profile.role.toLowerCase()} in ${city}, ${country}: ${projects.map((p) => p.data.title).join(', ')}.`;

const schema = graph(await person(), breadcrumbs([['Home', ''], ['Projects', 'projects/']]), {
  '@type': 'CollectionPage',
  url: absolute('projects/'),
  name: title,
  author: { '@id': personId() },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: projects.map((project, index) => ({ '@type': 'ListItem', position: index + 1, name: project.data.title, url: absolute(projectPath(project)) })),
  },
});
---
<Base title={title} description={description} schema={schema} stop="work">
  <section class="section">
    <div class="container">
      <div class="section-sign">
        <div>
          <h1 class="paint">Some of what I’ve built</h1>
          <p>A selection of my projects. Open any of them for the full story: what it does, how I built it and where it runs.</p>
        </div>
      </div>
      <Timetable projects={projects} caption="Selected projects" thumbs />
    </div>
  </section>
</Base>

<style>
  h1 {
    font-size: clamp(2.5rem, 6.5vw, 4.5rem);
  }
</style>
