---
// The "wrong stop" screen: the route board's brand, a clover decal, one plain sentence and the stops to go to.
// GitHub Pages only lets a static site customise "page not found" (404.html); it has no server that could fail.
import Clover from './Clover.astro';
import profile from '../data/profile.json';
import { url } from '../lib/url.js';

const { heading, text, links = [] } = Astro.props;
---
<main class="error">
  <a class="brand" href={url()}>
    <Clover size="1.4rem" />
    <span class="paint-plain">{profile.name}</span>
  </a>
  <div class="sign">
    <Clover class="decal" size="4.5rem" outline />
    <h1 class="paint">{heading}</h1>
    <p>{text}</p>
    <div class="actions">
      <a class="btn" href={url()}>Go to the home page</a>
      <button class="btn btn-line" type="button" data-back>Go back</button>
    </div>
  </div>
  {links.length > 0 && (
    <nav class="stops" aria-label="Popular pages">
      <p class="board-caps">Stops on this route</p>
      <ol>
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ol>
    </nav>
  )}
</main>

<script>
  document.querySelector('[data-back]')?.addEventListener('click', () => {
    if (history.length > 1 && document.referrer) history.back();
    else location.assign(document.querySelector<HTMLAnchorElement>('.brand')!.href);
  });
</script>

<style>
  .error {
    display: grid;
    align-content: center;
    gap: 2.2rem;
    min-height: 100vh;
    min-height: 100dvh;
    width: min(100% - 2rem, 34rem);
    margin-inline: auto;
    padding-block: 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    width: fit-content;
    padding: 0.55rem 0.9rem;
    border-radius: var(--radius);
    background: var(--route);
    color: var(--route-lit);
    text-decoration: none;
  }

  .brand span {
    color: #ffffff;
    font-size: 1rem;
  }

  .sign {
    position: relative;
  }

  .sign :global(.decal) {
    position: absolute;
    top: -1.5rem;
    right: 0;
    color: var(--clover);
    transform: rotate(14deg);
  }

  h1 {
    max-width: 10ch;
    font-size: clamp(2.6rem, 9vw, 4rem);
  }

  p {
    max-width: 26rem;
    margin-top: 1rem;
    font-size: 1.1rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .stops {
    padding-top: 1.4rem;
    border-top: var(--stripe) solid var(--band);
  }

  .stops p {
    margin: 0 0 0.8rem;
    color: var(--ground-muted);
    font-size: 0.78rem;
  }

  .stops ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .stops a {
    display: inline-block;
    padding: 0.45rem 0.8rem;
    border: 2px solid var(--ground-ink);
    border-radius: var(--radius);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
  }

  .stops a:hover {
    background: var(--ground-ink);
    color: var(--ground);
  }
</style>
