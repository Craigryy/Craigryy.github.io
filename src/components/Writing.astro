---
// Articles (src/data/writing.json), newest first, as a list ruled straight onto the body.
import Icon from './Icon.astro';
import { faArrowUpRightFromSquare } from '@fortawesome/free-solid-svg-icons';
import writing from '../data/writing.json';

const articles = [...writing.articles].sort((a, b) => String(b.date).localeCompare(String(a.date)));
const when = (date) => new Date(date).toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---
{articles.length > 0 && (
  <section class="section" id="writing" data-stop="writing" aria-labelledby="writing-title">
    <div class="container">
      <div class="section-sign">
        <div>
          <h2 id="writing-title" class="paint">Notes from the build</h2>
          <p>What I learn while building, written down for the next developer.</p>
        </div>
        {writing.profile && <a class="text-link" href={writing.profile} target="_blank" rel="noopener">All articles on Medium <Icon icon={faArrowUpRightFromSquare} /></a>}
      </div>
      <ul class="articles">
        {articles.map((article) => (
          <li>
            <a href={article.url} target="_blank" rel="noopener">
              <time class="board-caps" datetime={article.date}>{when(article.date)}</time>
              <span class="title">{article.title}</span>
              <span class="outlet">{article.outlet} <Icon icon={faArrowUpRightFromSquare} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .articles {
    list-style: none;
    border-top: var(--stripe) solid var(--band);
  }

  .articles a {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.4rem 1.5rem;
    padding: 1.25rem 0.25rem;
    border-bottom: 2px solid var(--ground-rule);
    text-decoration: none;
    transition: padding 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .articles a:hover {
    padding-left: 0.85rem;
  }

  time {
    color: var(--ground-muted);
  }

  .title {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .articles a:hover .title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--shade);
  }

  .outlet {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    color: var(--ground-muted);
    font-size: 0.9rem;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .articles a {
      grid-template-columns: 1fr auto;
    }

    .title {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
