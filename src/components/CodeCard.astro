---
// The editor window in the hero. Its "code" is written from profile.json, so editing the profile updates it.
import profile from '../data/profile.json';

const { titles = [] } = Astro.props;
const { area, city, country } = profile.location;

// Each line is a list of [kind, text] pieces; the kind picks the colour.
const str = (value) => ['s', JSON.stringify(value)];
const list = (items, perLine = 3) => {
  const rows = [];
  for (let i = 0; i < items.length; i += perLine) {
    const row = [['x', '    ']];
    items.slice(i, i + perLine).forEach((item, j, chunk) => row.push(str(item), ['x', j < chunk.length - 1 ? ', ' : ',']));
    rows.push(row);
  }
  return rows;
};
const lines = [
  [['k', 'const '], ['v', 'harrison'], ['x', ' = {']],
  [['x', '  '], ['p', 'role'], ['x', ': '], str(profile.role), ['x', ',']],
  [['x', '  '], ['p', 'based'], ['x', ': '], str([area, city, country].filter(Boolean).join(', ')), ['x', ',']],
  ...(titles.length
    ? [[['x', '  '], ['p', 'building'], ['x', ': [']], ...list(titles.map((t) => t.project.data.title), 2), [['x', '  ],']]]
    : []),
  [['x', '  '], ['p', 'stack'], ['x', ': [']],
  ...list(profile.codeCard || []),
  [['x', '  ],']],
  [['x', '};']],
];
---
<figure class="code-card" aria-label="A short profile written as code">
  <div class="chrome" aria-hidden="true">
    <span></span><span></span><span></span>
    <p class="mono">harrison.ts</p>
  </div>
  <pre class="mono"><code>{lines.map((line) => (
    <span class="line">{line.map(([kind, text]) => <span class={kind}>{text}</span>)}</span>
  ))}<span class="line"><span class="cursor" aria-hidden="true"></span></span></code></pre>
</figure>

<style>
  .code-card {
    margin: 0;
    overflow: hidden;
    border: 1px solid rgb(237 242 232 / 0.1);
    border-radius: var(--radius);
    background: var(--panel);
    color: #d7e2da;
    box-shadow: 0 30px 60px -20px rgb(15 36 30 / 0.45);
    transform: rotate(1deg);
    transition: transform 0.4s ease;
  }

  .code-card:hover {
    transform: rotate(0deg) translateY(-4px);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgb(237 242 232 / 0.08);
  }

  .chrome span {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: #ff6159;
  }

  .chrome span:nth-child(2) {
    background: #ffbd2e;
  }

  .chrome span:nth-child(3) {
    background: #28c941;
  }

  .chrome p {
    margin-left: 0.6rem;
    color: #8fa398;
    font-size: 0.78rem;
  }

  pre {
    margin: 0;
    padding: 1.1rem 1.2rem 1.3rem 0;
    overflow-x: auto;
    font-size: clamp(0.76rem, 1.35vw, 0.86rem);
    line-height: 1.75;
    counter-reset: line;
  }

  .line {
    display: block;
    white-space: pre;
  }

  .line::before {
    counter-increment: line;
    content: counter(line);
    display: inline-block;
    width: 2.6rem;
    padding-right: 1rem;
    color: #4f6559;
    text-align: right;
    user-select: none;
  }

  .c {
    color: #7d9488;
    font-style: italic;
  }

  .k {
    color: #c792ea;
  }

  .v {
    color: #82aaff;
  }

  .p {
    color: #d8fa68;
  }

  .s {
    color: #f6c177;
  }

  .b {
    color: #ff9e64;
  }

  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    vertical-align: text-bottom;
    background: #d8fa68;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 900px) {
    .code-card {
      transform: none;
    }
  }
</style>
