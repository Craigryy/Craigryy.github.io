---
// One project. Its content comes from src/content/projects/<name>/index.md (or the admin page).
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { faArrowRight, faArrowUpRightFromSquare } from '@fortawesome/free-solid-svg-icons';
import { faGithub } from '@fortawesome/free-brands-svg-icons';
import { projectUrl, coverName } from '../lib/projects.js';

const { project, featured = false, eager = false } = Astro.props;
const { title, tagline, role, year, url, repo, image, alt, stack } = project.data;
const href = projectUrl(project);
const shown = featured ? 7 : 4;
---
<article class:list={['card', { featured }]}>
  <a class="cover" href={href} tabindex="-1" aria-hidden="true" style={`view-transition-name: ${coverName(project)}`}>
    {image ? (
      <Image
        src={image}
        alt={alt || `${title} screenshot`}
        widths={[480, 800, 1200]}
        sizes={featured ? '(max-width: 900px) 100vw, 640px' : '(max-width: 700px) 100vw, 540px'}
        loading={eager ? 'eager' : 'lazy'}
      />
    ) : (
      <div class="placeholder"><span class="mono">{title}</span></div>
    )}
  </a>
  <div class="body">
    <p class="meta mono">
      <span>{year}</span>
      {role && <span class="sticker" style="--tilt: -3deg"><span class="story story-green role">{role}</span></span>}
    </p>
    <h3><a href={href}>{title}</a></h3>
    <p class="tagline">{tagline}</p>
    {stack.length > 0 && (
      <ul class="chips" aria-label="Built with">
        {stack.slice(0, shown).map((item) => <li class="chip">{item}</li>)}
        {stack.length > shown && <li class="chip more">+{stack.length - shown}</li>}
      </ul>
    )}
    <div class="links">
      <a class="text-link" href={href}>Case study <Icon icon={faArrowRight} /></a>
      {url && (
        <a class="out" href={url} target="_blank" rel="noopener">Live site <Icon icon={faArrowUpRightFromSquare} /><span class="visually-hidden"> ({title})</span></a>
      )}
      {repo && (
        <a class="out" href={repo} target="_blank" rel="noopener"><Icon icon={faGithub} /> Code<span class="visually-hidden"> for {title}</span></a>
      )}
    </div>
  </div>
</article>

<style>
  .card {
    display: grid;
    gap: 1.1rem;
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 6px);
    background: var(--surface);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
    transform: translateY(-4px);
  }

  .featured {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.25rem, 4vw, 2.75rem);
  }

  .cover {
    display: block;
    overflow: hidden;
    text-decoration: none;
    border-radius: var(--radius);
    background: var(--bg-2);
    aspect-ratio: 16 / 10;
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.6s cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .card:hover .cover img {
    transform: scale(1.03);
  }

  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 20% 20%, color-mix(in srgb, var(--accent) 55%, transparent), transparent 55%),
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 28px 28px,
      var(--bg-2);
  }

  .placeholder span {
    color: var(--ink);
    font-size: clamp(1.2rem, 3vw, 1.7rem);
    font-weight: 500;
    text-align: center;
  }

  .placeholder span::before {
    content: '> ';
    color: var(--link);
  }

  .body {
    padding: 0.25rem 0.6rem 0.6rem;
  }

  .featured .body {
    padding: 1rem 1rem 1rem 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .role {
    font-size: 0.85rem;
  }

  h3 {
    margin-top: 0.6rem;
    font-size: 1.4rem;
  }

  .featured h3 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .tagline {
    margin-top: 0.5rem;
    color: var(--ink-2);
  }

  .chips {
    margin-top: 1.1rem;
  }

  .more {
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.2rem;
    margin-top: 1.4rem;
    font-size: 0.95rem;
  }

  .out {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-2);
    font-weight: 500;
    text-decoration: none;
  }

  .out:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .out :global(svg) {
    font-size: 0.8em;
  }

  @media (max-width: 900px) {
    .featured {
      grid-template-columns: 1fr;
    }

    .featured .body {
      padding: 0.25rem 0.6rem 0.6rem;
    }
  }
</style>
