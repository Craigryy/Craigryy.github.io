---
// A featured project as a stop on the route: the screenshot in a bus window with a painted signboard bolted
// alongside. Content comes from src/content/projects/<name>/index.md (or the admin page). `flip` swaps the sides.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { faArrowRight, faArrowUpRightFromSquare } from '@fortawesome/free-solid-svg-icons';
import { faGithub } from '@fortawesome/free-brands-svg-icons';
import { projectUrl, coverName, titleOf, roleLabel } from '../lib/projects.js';

const { project, flip = false, eager = false } = Astro.props;
const { title, tagline, role, year, url, repo, image, alt, stack } = project.data;
const href = projectUrl(project);
const shown = 6;
---
<article class:list={['stop', { flip }]}>
  <a class="window shot" href={href} tabindex="-1" aria-hidden="true" style={`view-transition-name: ${coverName(project)}`}>
    {image ? (
      <Image
        src={image}
        alt={alt || `${title} screenshot`}
        widths={[560, 860, 1240]}
        sizes="(max-width: 900px) 100vw, 680px"
        loading={eager ? 'eager' : 'lazy'}
      />
    ) : (
      <span class="no-shot paint-plain">{title}</span>
    )}
  </a>

  <div class="board sign">
    <h3 class="paint-plain"><a href={href}>{title}</a></h3>
    <p class="strip board-caps">
      <time class="nums" datetime={String(year)}>{year}</time>
      {roleLabel(role) && <span>{titleOf(project)}</span>}
    </p>
    <p class="tagline">{tagline}</p>
    {stack.length > 0 && (
      <ol class="route-line" aria-label="Built with">
        {stack.slice(0, shown).map((item) => <li>{item}</li>)}
        {stack.length > shown && <li class="more">+{stack.length - shown} more</li>}
      </ol>
    )}
    <div class="links">
      <a class="btn btn-sm" href={href}>Read the case study <Icon icon={faArrowRight} /></a>
      {url && <a class="out" href={url} target="_blank" rel="noopener">Live site <Icon icon={faArrowUpRightFromSquare} /><span class="visually-hidden"> ({title})</span></a>}
      {repo && <a class="out" href={repo} target="_blank" rel="noopener"><Icon icon={faGithub} /> Code<span class="visually-hidden"> for {title}</span></a>}
    </div>
  </div>
</article>

<style>
  .stop {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: center;
  }

  .shot {
    grid-column: 1;
    grid-row: 1;
    text-decoration: none;
  }

  .shot img {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stop:hover .shot img {
    transform: translateY(-1.5%) scale(1.015);
  }

  .no-shot {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    color: var(--route-lit);
    font-size: clamp(1.4rem, 3vw, 2rem);
  }

  /* The signboard overlaps the window edge, bolted on top of it. */
  .sign {
    grid-column: 2;
    grid-row: 1;
    z-index: 1;
    margin-left: -3.5rem;
    padding: 1.6rem 1.8rem 1.7rem;
  }

  .flip {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
  }

  .flip .shot {
    grid-column: 2;
  }

  .flip .sign {
    grid-column: 1;
    margin-left: 0;
    margin-right: -3.5rem;
  }

  .strip {
    position: relative;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    margin-top: 0.9rem;
    padding: 0.45rem 0.8rem;
    background: var(--band);
    color: var(--band-ink);
  }

  .strip time {
    color: var(--route-lit);
  }

  :global(:root[data-theme='dark']) .strip time {
    color: var(--band-ink);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .strip time {
      color: var(--band-ink);
    }
  }

  h3 {
    position: relative;
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    line-height: 1;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--shade);
    text-decoration-thickness: 3px;
  }

  .tagline {
    margin-top: 0.75rem;
    color: var(--board-muted);
    font-size: 1.04rem;
  }

  .route-line {
    margin-top: 1.25rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.2rem;
    margin-top: 1.5rem;
  }

  .out {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .out:hover {
    text-decoration-color: var(--shade);
  }

  .out :global(svg) {
    font-size: 0.8em;
  }

  @media (max-width: 900px) {
    .stop,
    .flip {
      grid-template-columns: 1fr;
    }

    .shot,
    .flip .shot {
      grid-column: 1;
      grid-row: 1;
    }

    .sign,
    .flip .sign {
      grid-column: 1;
      grid-row: 2;
      margin: -2rem 0.75rem 0;
    }
  }
</style>
