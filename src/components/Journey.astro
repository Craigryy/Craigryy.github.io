---
// The route so far: what he's on now, work and study as a timetable of stops, and who recommends him.
// Data: src/data/journey.json, plus the roles from the projects.
import journey from '../data/journey.json';
import { projectUrl } from '../lib/projects.js';

const { titles = [] } = Astro.props;
---
<section class="section" id="journey" data-stop="journey" aria-labelledby="journey-title">
  <div class="container">
    <div class="section-sign">
      <div>
        <h2 id="journey-title" class="paint">The route so far</h2>
        <p>Where I’ve worked, what I’ve studied, and what I’m building now.</p>
      </div>
    </div>

    <div class="columns">
      <div class="board line">
        <h3 class="head board-caps">Work</h3>
        <ol class="stops">
          {titles.length > 0 && (
            <li class="now">
              <p class="when board-caps">Now</p>
              <ul class="now-list">
                {titles.map(({ project, text }) => (
                  <li><a href={projectUrl(project)}>{text}</a><span>{project.data.tagline}</span></li>
                ))}
              </ul>
            </li>
          )}
          {journey.experience.map((job) => (
            <li>
              <p class="when board-caps nums">{job.period}</p>
              <h4>{job.role}</h4>
              <p class="org">{job.org}{job.place && ` · ${job.place}`}</p>
              {job.points?.length > 0 && <ul class="points">{job.points.map((point) => <li>{point}</li>)}</ul>}
            </li>
          ))}
        </ol>
      </div>

      <div class="side">
        <div class="board line">
          <h3 class="head board-caps">Study</h3>
          <ol class="stops">
            {journey.education.map((item) => (
              <li>
                <p class="when board-caps nums">{item.period}</p>
                <h4>{item.title}</h4>
                <p class="org">{item.org}{item.note && ` · ${item.note}`}</p>
              </li>
            ))}
          </ol>
        </div>

        {journey.references?.length > 0 && (
          <div class="refs">
            <h3>Recommended by</h3>
            {journey.references.map((ref) => (
              <figure class="ref">
                <p class="ref-name">{ref.name}</p>
                <p>{ref.role}</p>
                {ref.context && <p class="ref-context">{ref.context}</p>}
              </figure>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .columns {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 2.5rem);
    align-items: start;
  }

  .side {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .line {
    padding: 0 1.7rem 1.4rem;
  }

  .head {
    position: relative;
    z-index: 1;
    margin: 0 -1.7rem 1.4rem;
    padding: 0.7rem 1.7rem;
    background: var(--band);
    color: var(--band-ink);
  }

  /* A route line down the left: one stop per job or course. */
  .stops {
    position: relative;
    list-style: none;
  }

  .stops::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.4rem;
    bottom: 0.2rem;
    width: 2px;
    background: var(--board-ink);
  }

  .stops > li {
    position: relative;
    padding: 0 0 1.6rem 1.4rem;
  }

  .stops > li:last-child {
    padding-bottom: 0.2rem;
  }

  .stops > li::before {
    content: '';
    position: absolute;
    left: calc(1px - 0.475rem);
    top: 0.15rem;
    width: 0.95rem;
    height: 0.95rem;
    border: 3px solid var(--board-ink);
    border-radius: 50%;
    background: var(--board);
  }

  .stops > li.now::before {
    background: var(--shade);
  }

  .when {
    color: var(--board-muted);
    font-size: 0.82rem;
  }

  h4 {
    margin-top: 0.3rem;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }

  .org {
    margin-top: 0.2rem;
    color: var(--board-muted);
  }

  .points {
    margin-top: 0.7rem;
    padding-left: 1.1rem;
    font-size: 0.98rem;
  }

  .points li + li {
    margin-top: 0.35rem;
  }

  .points li::marker {
    color: var(--shade);
  }

  .now-list {
    display: grid;
    gap: 0.7rem;
    margin-top: 0.4rem;
    list-style: none;
  }

  .now-list a {
    font-weight: 800;
    font-size: 1.08rem;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .now-list a:hover {
    text-decoration-color: var(--shade);
  }

  .now-list span {
    display: block;
    margin-top: 0.15rem;
    color: var(--board-muted);
    font-size: 0.95rem;
  }

  .refs h3 {
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .ref {
    margin: 0;
    padding: 1.1rem 1.3rem;
    border-left: 0;
    background: var(--band);
    color: var(--band-ink);
    border-radius: var(--radius);
  }

  .ref + .ref {
    margin-top: 0.75rem;
  }

  .ref-name {
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: 1.2rem;
  }

  .ref-context {
    margin-top: 0.4rem;
    color: var(--band-muted);
    font-size: 0.92rem;
  }

  @media (max-width: 820px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }
</style>
