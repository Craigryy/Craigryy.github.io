---
import journey from '../data/journey.json';
import { projectUrl } from '../lib/projects.js';

const { titles = [] } = Astro.props;
---
<section class="section" id="journey" aria-labelledby="journey-title">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="index">03 / Journey</span>
        <h2 id="journey-title">Experience and education</h2>
        <p>Where I’ve worked, what I’ve studied, and what I’m building now.</p>
      </div>
    </div>

    <div class="columns">
      <div>
        <h3 class="col-title mono">Experience</h3>
        <ol class="timeline">
          {titles.length > 0 && (
            <li class="now">
              <p class="period mono">Now</p>
              <ul class="now-list">
                {titles.map(({ project, text }) => (
                  <li><a href={projectUrl(project)}>{text}</a> <span>{project.data.tagline}</span></li>
                ))}
              </ul>
            </li>
          )}
          {journey.experience.map((job) => (
            <li>
              <p class="period mono">{job.period}</p>
              <h4>{job.role}</h4>
              <p class="org">{job.org}{job.place && ` · ${job.place}`}</p>
              {job.points?.length > 0 && <ul class="points">{job.points.map((point) => <li>{point}</li>)}</ul>}
            </li>
          ))}
        </ol>
      </div>

      <div>
        <h3 class="col-title mono">Education</h3>
        <ol class="timeline">
          {journey.education.map((item) => (
            <li>
              <p class="period mono">{item.period}</p>
              <h4>{item.title}</h4>
              <p class="org">{item.org}{item.note && ` · ${item.note}`}</p>
            </li>
          ))}
        </ol>

        {journey.references?.length > 0 && (
          <div class="references">
            <h3 class="col-title mono">Recommended by</h3>
            {journey.references.map((ref) => (
              <figure class="reference">
                <p class="ref-name">{ref.name}</p>
                <p class="org">{ref.role}</p>
                {ref.context && <p class="period mono">{ref.context}</p>}
              </figure>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .col-title {
    margin-bottom: 1.4rem;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line-strong);
  }

  .timeline > li {
    position: relative;
    padding: 0 0 2rem 1.6rem;
  }

  .timeline > li::before {
    content: '';
    position: absolute;
    left: -0.36rem;
    top: 0.35rem;
    width: 0.7rem;
    height: 0.7rem;
    border: 2px solid var(--bg);
    border-radius: 50%;
    background: var(--line-strong);
  }

  .timeline > li.now::before {
    background: var(--accent);
    box-shadow: 0 0 0 1px var(--ink);
  }

  .period {
    color: var(--muted);
    font-size: 0.8rem;
  }

  h4 {
    margin: 0.3rem 0 0;
    font-size: 1.12rem;
    letter-spacing: -0.02em;
  }

  .org {
    margin-top: 0.2rem;
    color: var(--ink-2);
  }

  .points {
    margin-top: 0.75rem;
    padding-left: 1.1rem;
    color: var(--ink-2);
    font-size: 0.97rem;
  }

  .points li + li {
    margin-top: 0.35rem;
  }

  .now-list {
    display: grid;
    gap: 0.6rem;
    margin-top: 0.5rem;
    list-style: none;
  }

  .now-list a {
    font-weight: 700;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
  }

  .now-list a:hover {
    text-decoration-color: currentColor;
  }

  .now-list span {
    display: block;
    color: var(--muted);
    font-size: 0.93rem;
  }

  .references {
    margin-top: 1.5rem;
  }

  .reference {
    margin: 0;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .reference + .reference {
    margin-top: 0.75rem;
  }

  .ref-name {
    font-weight: 700;
  }

  .reference .period {
    margin-top: 0.5rem;
  }

  @media (max-width: 760px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }
</style>
