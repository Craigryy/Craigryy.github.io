---
// The route board: always charcoal, lit letters. The stop you're on is lit and the rest are ghosted; on the home page
// the lit stop follows the section you're reading.
import Icon from './Icon.astro';
import Clover from './Clover.astro';
import { faMoon, faSun, faBars, faXmark } from '@fortawesome/free-solid-svg-icons';
import profile from '../data/profile.json';
import { url } from '../lib/url.js';

// `stop` lights one stop on pages that aren't the home page.
const { stop = '' } = Astro.props;
const stops = [
  { id: 'work', href: url('#work'), label: 'Work' },
  { id: 'stack', href: url('#stack'), label: 'Stack' },
  { id: 'journey', href: url('#journey'), label: 'Journey' },
  { id: 'writing', href: url('#writing'), label: 'Writing' },
  { id: 'about', href: url('about/'), label: 'About' },
];
---
<header class="route-board">
  <div class="container bar">
    <a class="plate" href={url()} aria-label={`${profile.name}, home`}>
      <Clover size="1.55rem" />
      <span class="plate-name">{profile.name}</span>
    </a>

    <nav class="stops" aria-label="Main">
      <ol>
        {stops.map((s) => (
          <li>
            <a href={s.href} data-stop-link={s.id} class:list={{ lit: s.id === stop }} aria-current={s.id === stop ? 'page' : undefined}>
              {s.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="controls">
      <button class="round" type="button" data-theme-toggle aria-label="Switch between day and night colours">
        <span class="moon"><Icon icon={faMoon} /></span>
        <span class="sun"><Icon icon={faSun} /></span>
      </button>
      <a class="hire" href={url('#contact')}>Hire me</a>
      <details class="menu" data-menu>
        <summary class="round" aria-label="Menu">
          <span class="open"><Icon icon={faBars} /></span>
          <span class="close"><Icon icon={faXmark} /></span>
        </summary>
        <div class="menu-panel">
          <ol>
            {stops.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
            <li><a href={url('#contact')}>Contact</a></li>
          </ol>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Day / night colours: remembers the choice on this device.
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  // Phone menu: close it after a link is tapped, on Escape, or on a tap outside it.
  const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');
  if (menu) {
    menu.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') menu.open = false;
    });
    document.addEventListener('click', (event) => {
      if (!menu.contains(event.target as Node)) menu.open = false;
    });
  }

  // On the home page, light the stop for the section you're reading.
  const sections = [...document.querySelectorAll<HTMLElement>('[data-stop]')];
  if (sections.length) {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-stop-link]')];
    const light = (id: string) =>
      links.forEach((a) => {
        const on = a.dataset.stopLink === id;
        a.classList.toggle('lit', on);
        if (on) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
    const watcher = new IntersectionObserver(
      (entries) => {
        const seen = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (seen) light(seen.target.getAttribute('data-stop')!);
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => watcher.observe(s));
  }
</script>

<style>
  .route-board {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--route);
    color: #ffffff;
    --focus: var(--route-lit);
  }

  /* Night service: a burgundy rule under the board keeps it apart from the dark body. */
  .route-board::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--route-accent);
    opacity: 0;
  }

  :global(:root[data-theme='dark']) .route-board::after {
    opacity: 1;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .route-board::after {
      opacity: 1;
    }
  }

  .bar {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    min-height: 4.25rem;
  }

  .plate {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--route-lit);
    text-decoration: none;
  }

  .plate-name {
    color: #ffffff;
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: 1.05rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .stops {
    margin-left: auto;
  }

  .stops ol {
    display: flex;
    gap: 0.15rem;
    list-style: none;
  }

  .stops a {
    display: block;
    padding: 0.5rem 0.7rem;
    color: var(--route-ghost);
    font-stretch: 78%;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .stops a:hover,
  .stops a.lit {
    color: var(--route-lit);
  }

  .stops a.lit {
    text-decoration: underline;
    text-decoration-color: var(--route-accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.5em;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .round {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: 50%;
    background: transparent;
    color: #ffffff;
    font-size: 0.95rem;
    cursor: pointer;
  }

  .round:hover {
    border-color: var(--route-lit);
    color: var(--route-lit);
  }

  .hire {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius);
    background: var(--route-accent);
    color: #ffffff;
    font-weight: 800;
    font-size: 0.92rem;
    text-decoration: none;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hire:hover {
    transform: translateY(-2px);
  }

  .sun,
  :global(:root[data-theme='dark']) .moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .sun {
    display: inline;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .moon {
      display: none;
    }

    :global(:root:not([data-theme='light'])) .sun {
      display: inline;
    }
  }

  .menu {
    position: relative;
    display: none;
  }

  .menu summary {
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu .close,
  .menu[open] .open {
    display: none;
  }

  .menu[open] .close {
    display: inline;
  }

  .menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.75rem);
    min-width: 13rem;
    padding: 0.4rem;
    border-radius: var(--radius);
    background: var(--route);
    box-shadow: inset 0 0 0 1px rgb(242 237 230 / 0.18), 0 18px 30px -12px rgb(0 0 0 / 0.6);
  }

  .menu-panel ol {
    list-style: none;
  }

  .menu-panel a {
    display: block;
    padding: 0.75rem 0.9rem;
    color: var(--route-lit);
    font-stretch: 78%;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .menu-panel a:hover {
    background: rgb(242 237 230 / 0.08);
  }

  @media (max-width: 980px) {
    .stops {
      display: none;
    }

    .controls {
      margin-left: auto;
    }

    .menu {
      display: block;
    }
  }

  @media (max-width: 380px) {
    .plate-name {
      display: none;
    }
  }

</style>
