---
// The footer: the name, the socials, and how the site is built.
import Icon from './Icon.astro';
import AstroLogo from './AstroLogo.astro';
import profile from '../data/profile.json';
import { socialIcon } from '../lib/socials.js';
import { url } from '../lib/url.js';

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container top">
    <div class="who">
      <p class="name">{profile.name}</p>
      <p>{profile.role}</p>
    </div>
    <ul class="socials">
      {profile.socials.map((social) => (
        <li>
          <a href={social.url} target="_blank" rel="noopener me" aria-label={social.label}>
            <Icon icon={socialIcon(social.network)} />
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="container bottom">
    <p>© {year} {profile.name}</p>
    <p class="built">
      <a href="https://astro.build" target="_blank" rel="noopener">Built with <AstroLogo /> Astro</a>
      <span aria-hidden="true">·</span>
      <span>Hosted on GitHub Pages</span>
      <span aria-hidden="true">·</span>
      <a href={url('about/#colophon')}>How this site works</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(2.5rem, 6vw, 3.5rem) 2rem;
    color: var(--ground-muted);
    font-size: 0.94rem;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2rem;
  }

  .who {
    flex: 1;
    min-width: 14rem;
  }

  .name {
    color: var(--ground-ink);
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: 1.35rem;
  }

  .socials {
    display: flex;
    gap: 0.5rem;
    list-style: none;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 2px solid var(--ground-ink);
    border-radius: 50%;
    color: var(--ground-ink);
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .socials a:hover {
    background: var(--ground-ink);
    color: var(--ground);
    transform: translateY(-2px);
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 2px solid var(--ground-rule);
  }

  .built {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
  }

  .built a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ground-ink);
    font-weight: 600;
    text-decoration: underline;
  }

  .built a:hover {
    text-decoration-color: var(--shade);
  }

  .built :global(.astro-logo) {
    width: 0.8rem;
    height: auto;
  }
</style>
