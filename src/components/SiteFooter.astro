---
import Icon from './Icon.astro';
import AstroLogo from './AstroLogo.astro';
import profile from '../data/profile.json';
import { socialIcon } from '../lib/socials.js';
import { url } from '../lib/url.js';

const year = new Date().getFullYear();
const { area, city, country } = profile.location;
---
<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div>
        <p class="name">{profile.name}</p>
        <p class="where">{profile.role} · {area}, {city}, {country}</p>
      </div>
      <ul class="socials">
        {profile.socials.map((social) => (
          <li>
            <a href={social.url} target="_blank" rel="noopener me" aria-label={social.label}>
              <Icon icon={socialIcon(social.network)} />
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="bottom">
      <p>© {year} {profile.name}</p>
      <p class="built">
        <a href="https://astro.build" target="_blank" rel="noopener">Built with <AstroLogo /> Astro</a>
        <span aria-hidden="true">·</span>
        <span>Hosted on GitHub Pages</span>
        <span aria-hidden="true">·</span>
        <a href={url('about/#colophon')}>How this site works</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 3rem 2.5rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .top,
  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
  }

  .bottom {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .name {
    color: var(--ink);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .where {
    margin-top: 0.2rem;
  }

  .socials {
    display: flex;
    gap: 0.5rem;
    list-style: none;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--ink);
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .socials a:hover {
    background: var(--ink);
    color: var(--bg);
    transform: translateY(-2px);
  }

  .built {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
  }

  .built a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink-2);
    text-decoration: none;
  }

  .built a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .built :global(.astro-logo) {
    width: 0.8rem;
    height: auto;
  }
</style>
