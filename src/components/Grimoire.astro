---
// A black grimoire with a five-leaf clover on the cover, drawn for this site (no official artwork): the stand-in
// for character art in the manga panel until art is uploaded in the admin.
const leaf = 'M0 2.6 C -4.6 -2.4 -9.8 -8.6 -6.6 -14.6 C -4.9 -17.4 -1.4 -17.2 0 -14.4 C 1.4 -17.2 4.9 -17.4 6.6 -14.6 C 9.8 -8.6 4.6 -2.4 0 2.6 Z';
const angles = [0, 72, 144, 216, 288];
---
<svg class="grimoire" viewBox="0 0 200 250" role="img" aria-label="A black grimoire with a five-leaf clover on its cover">
  <ellipse class="shadow" cx="102" cy="236" rx="62" ry="7" />
  <g class="book">
    <!-- pages, seen past the back cover -->
    <rect x="46" y="30" width="124" height="186" rx="5" fill="#efe9de" />
    {[44, 74, 104, 134, 164, 194].map((y) => <path d={`M168 ${y} h-4`} stroke="#b9b1a4" stroke-width="1.2" />)}
    <rect x="40" y="24" width="130" height="194" rx="8" fill="#0d0c0d" />
    <!-- front cover and spine -->
    <rect x="30" y="16" width="134" height="196" rx="8" fill="#1d1b1d" stroke="#050505" stroke-width="2" />
    <rect x="30" y="16" width="18" height="196" rx="6" fill="#121112" />
    <path d="M38 30 v168" stroke="#2b282b" stroke-width="2" />
    <!-- iron corner plates -->
    <g fill="#77706a">
      <path d="M164 16 h-26 l26 26 z" /><path d="M164 212 h-26 l26 -26 z" />
      <path d="M48 16 h18 l-18 18 z" /><path d="M48 212 h18 l-18 -18 z" />
    </g>
    <!-- the clasp -->
    <rect x="156" y="100" width="20" height="26" rx="4" fill="#3a3537" stroke="#050505" stroke-width="1.5" />
    <!-- the emblem: a burgundy ring and a five-leaf clover -->
    <circle cx="106" cy="112" r="38" fill="none" stroke="#8a1c33" stroke-width="5" />
    <circle cx="106" cy="112" r="31" fill="none" stroke="#3a3537" stroke-width="1.5" />
    <g transform="translate(106 112) scale(1.45)" fill="#d9d2c8">
      {angles.map((a) => <path d={leaf} transform={`rotate(${a})`} />)}
      <circle r="4.2" />
    </g>
    <g transform="translate(106 112) scale(1.45)" stroke="#1d1b1d" stroke-width="0.9" stroke-linecap="round" opacity="0.7">
      {angles.map((a) => <path d="M0 -3.2 L0 -12.6" transform={`rotate(${a})`} />)}
    </g>
  </g>
</svg>

<style>
  .grimoire {
    width: min(100%, 11rem);
    height: auto;
    overflow: visible;
  }

  .shadow {
    fill: rgb(0 0 0 / 0.22);
    transform-origin: 102px 236px;
  }

  /* The page's one authored motion: the grimoire floats, its shadow breathing with it. */
  @media (prefers-reduced-motion: no-preference) {
    .book {
      animation: float 4.5s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    }

    .shadow {
      animation: shadow 4.5s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    }
  }

  @keyframes float {
    50% {
      transform: translateY(-9px) rotate(-1.5deg);
    }
  }

  @keyframes shadow {
    50% {
      transform: scaleX(0.82);
      opacity: 0.6;
    }
  }
</style>
