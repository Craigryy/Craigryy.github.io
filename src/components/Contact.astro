---
// The last stop. GitHub Pages can't send email itself, so the form posts to Web3Forms (free), which forwards it to
// the inbox. Without a key (PUBLIC_WEB3FORMS_KEY, see the README) the section shows email and LinkedIn buttons instead.
import Icon from './Icon.astro';
import Clover from './Clover.astro';
import { faArrowRight, faClock, faDownload, faEnvelope } from '@fortawesome/free-solid-svg-icons';
import { faLinkedin } from '@fortawesome/free-brands-svg-icons';
import profile from '../data/profile.json';
import { url } from '../lib/url.js';

const key = import.meta.env.PUBLIC_WEB3FORMS_KEY;
const linkedin = profile.socials.find((s) => s.network === 'linkedin');
---
<section class="contact on-band" id="contact" data-stop="contact" aria-labelledby="contact-title">
  <div class="container panel">
    <div class="intro">
      <h2 id="contact-title" class="paint">Let’s build something together.</h2>
      <p class="pitch">Tell me about your team or your project and I’ll reply by email.</p>
      <a class="email" href={`mailto:${profile.email}`}>{profile.email} <Icon icon={faArrowRight} /></a>
      <ul class="facts">
        <li><Icon icon={faClock} /> West Africa Time (UTC+1)</li>
        <li><a href={url(profile.cv)} download><Icon icon={faDownload} /> Download my CV</a></li>
      </ul>
    </div>

    {key ? (
      <form class="form" action="https://api.web3forms.com/submit" method="POST" data-contact>
        <input type="hidden" name="access_key" value={key} />
        <input type="hidden" name="subject" value="New message from your portfolio" />
        <input type="hidden" name="from_name" value={`${profile.name} portfolio`} />
        <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label>
          <span>Your name</span>
          <input name="name" required maxlength="100" autocomplete="name" />
        </label>
        <label>
          <span>Your email</span>
          <input type="email" name="email" required maxlength="200" autocomplete="email" />
        </label>
        <label>
          <span>Message</span>
          <textarea name="message" required rows="5" maxlength="3000" placeholder="A role, a project, or just hello"></textarea>
        </label>
        <button class="btn" type="submit" data-send>Send message <Icon icon={faArrowRight} /></button>
        <p class="status" role="status" aria-live="polite" data-status></p>
      </form>
    ) : (
      <div class="direct">
        <p>The quickest way to reach me:</p>
        <a class="btn" href={`mailto:${profile.email}`}><Icon icon={faEnvelope} /> Email me</a>
        {linkedin && <a class="btn btn-line" href={linkedin.url} target="_blank" rel="noopener"><Icon icon={faLinkedin} /> Message me on LinkedIn</a>}
      </div>
    )}
    <Clover class="decal" size="5.5rem" />
  </div>
</section>

<script>
  // Sends the form without leaving the page. Without JavaScript the form still posts to Web3Forms normally.
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('[data-send]')!;
    const email = form.closest('.panel')?.querySelector<HTMLAnchorElement>('.email')?.textContent?.trim();
    const say = (text: string, state: string) => {
      status.textContent = text;
      status.dataset.state = state;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      if (data.botcheck) return;
      button.disabled = true;
      say('Sending…', 'sending');
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ ...data, subject: `New message from ${data.name} (portfolio)` }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.success) throw new Error(result.message);
        form.reset();
        say('Thanks! Your message is on its way. I’ll reply by email.', 'sent');
      } catch {
        say(`Couldn’t send right now. Please email me at ${email}.`, 'error');
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .contact {
    margin-top: clamp(1rem, 3vw, 2rem);
    background: var(--band);
    color: var(--band-ink);
    box-shadow: 0 calc(var(--stripe) / -1.5) 0 0 var(--ground), 0 calc(var(--stripe) / -1) 0 0 var(--band);
  }

  .panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 4.5rem);
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  h2 {
    color: var(--band-ink);
    font-size: clamp(2.2rem, 5.4vw, 3.8rem);
    max-width: 13ch;
  }

  .pitch {
    max-width: 30rem;
    margin-top: 1.1rem;
    color: var(--band-muted);
    font-size: 1.1rem;
  }

  .email {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.8rem;
    color: inherit;
    font-size: clamp(1.1rem, 2.6vw, 1.5rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-decoration-color: rgb(255 255 255 / 0.5);
    text-underline-offset: 0.25em;
    word-break: break-all;
  }

  .facts {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.8rem;
    color: var(--band-muted);
    list-style: none;
  }

  .facts li,
  .facts a {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .facts a {
    color: inherit;
    font-weight: 700;
    text-decoration: underline;
  }

  .facts a:hover {
    color: var(--band-ink);
  }

  .facts :global(svg) {
    width: 1rem;
    color: var(--band-ink);
    opacity: 0.75;
  }

  .form,
  .direct {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .direct {
    align-content: center;
    justify-items: start;
  }

  .direct p {
    color: var(--band-muted);
    font-weight: 600;
  }

  label {
    display: grid;
    gap: 0.4rem;
    font-size: 0.92rem;
    font-weight: 700;
  }

  input,
  textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 2px solid transparent;
    border-radius: var(--radius);
    background: var(--board);
    color: var(--board-ink);
    font: inherit;
    font-size: 1rem;
    font-weight: 400;
    caret-color: var(--shade);
  }

  textarea {
    resize: vertical;
    min-height: 8rem;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--board-muted);
  }

  input:focus,
  textarea:focus {
    border-color: var(--board-ink);
    outline: none;
  }

  .form .btn {
    justify-self: start;
  }

  .form .btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .status {
    min-height: 1.5em;
    font-weight: 600;
  }

  .status[data-state='error'] {
    color: #ffd2d9;
  }

  .panel :global(.decal) {
    position: absolute;
    right: 0;
    bottom: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--clover);
    opacity: 0.85;
    transform: rotate(-12deg);
  }

  @media (max-width: 820px) {
    .panel {
      grid-template-columns: 1fr;
      padding-bottom: 7rem;
    }
  }
</style>
