---
// Movement on every page: things rise, slide or pop in as they scroll into view, the clover decals bob, cards lift
// on hover. Pure CSS plus one small observer. Without JavaScript, or with reduced motion, everything just shows.
---
<script is:inline>
  (() => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    const root = document.documentElement;
    root.classList.add('motion');

    // [selector, effect]. Effects: up (rise), left / right (slide in from that side), pop (grow from small).
    const rules = [
      ['.hero .copy > *', 'up'],
      ['.section-sign', 'up'],
      ['.services .group', 'up'],
      ['.columns .board', 'up'],
      ['.refs .ref', 'drop'],
      ['.articles > li', 'drop'],
      ['.contact .panel > *', 'up'],
      ['main .window', 'pop'],
      ['main .board', 'up'],
      ['main .prose > *', 'up'],
      ['main h1', 'up'],
      ['main table tr', 'up'],
      ['.socials li', 'pop'],
    ];

    const tag = () => {
      const seen = new Set();
      for (const [selector, effect] of rules) {
        document.querySelectorAll(selector).forEach((el) => {
          if (el.dataset.reveal || seen.has(el) || el.closest('.featured')) return;
          seen.add(el);
          el.dataset.reveal = effect;
        });
      }
      // Siblings arriving together come in one after another.
      document.querySelectorAll('[data-reveal]').forEach((el) => {
        const group = [...el.parentElement.children].filter((c) => c.dataset.reveal);
        el.style.setProperty('--i', Math.min(group.indexOf(el), 8));
      });
    };

    const watch = () => {
      tag();
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('shown');
          io.unobserve(e.target);
        }),
        { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
      );
      document.querySelectorAll('[data-reveal]:not(.shown)').forEach((el) => io.observe(el));
    };

    // The swordsman: dashes across a section as it arrives and cuts the air; the cards drop in behind the slash.
    const runner = () => {
      const el = document.createElement('div');
      el.className = 'blade-run';
      el.setAttribute('aria-hidden', 'true');
      el.innerHTML = `
        <svg class="runner" viewBox="0 0 120 120" width="120" height="120">
          <g class="body" fill="currentColor">
            <circle cx="70" cy="26" r="11"/>
            <path d="M58 22 L44 14 L50 26 Z"/>
            <path d="M62 36 L80 38 L74 70 L52 70 Z"/>
            <path class="cape" d="M60 38 L22 52 L30 60 L54 64 Z" opacity=".75"/>
            <path class="leg-a" d="M56 68 L40 92 L30 108 L38 110 L50 94 L64 72 Z"/>
            <path class="leg-b" d="M68 68 L86 88 L100 102 L104 96 L92 84 L76 66 Z"/>
            <path d="M76 42 L96 52 L94 58 L74 50 Z"/>
          </g>
          <rect class="sword" x="92" y="50" width="34" height="3.5" rx="1.5" transform="rotate(-25 94 52)"/>
        </svg>
        <svg class="cut" viewBox="0 0 400 120" preserveAspectRatio="none"><path pathLength="1" d="M0 100 Q200 -10 400 30" /></svg>`;
      return el;
    };

    const slashOn = (section) => {
      if (section.dataset.slashed) return;
      section.dataset.slashed = '1';
      const el = runner();
      section.prepend(el);
      el.addEventListener('animationend', (e) => { if (e.target === el) el.remove(); });
    };

    const slashWatch = () => {
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (!e.isIntersecting) return;
          slashOn(e.target);
          io.unobserve(e.target);
        }),
        { threshold: 0.2 },
      );
      document.querySelectorAll('main > section, .hero').forEach((s) => io.observe(s));
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', slashWatch);
    else slashWatch();

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', watch);
    else watch();
  })();
</script>

<style is:global>
  .motion [data-reveal] {
    opacity: 0;
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i, 0) * 90ms);
  }

  .motion [data-reveal='up'] { transform: translateY(36px); }
  .motion [data-reveal='left'] { transform: translateX(-40px); }
  .motion [data-reveal='right'] { transform: translateX(40px); }
  .motion [data-reveal='pop'] {
    transform: scale(0.6);
    transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Dropped from above, landing with a small bounce, a beat after the slash passes. */
  .motion [data-reveal='drop'] {
    transform: translateY(-140px) rotate(-4deg);
    transition-timing-function: cubic-bezier(0.34, 1.45, 0.64, 1);
    transition-delay: calc(0.45s + var(--i, 0) * 110ms);
  }

  .motion [data-reveal].shown {
    opacity: 1;
    transform: none;
  }

  /* The swordsman's dash and cut. */
  .motion main > section,
  .motion .hero {
    position: relative;
  }

  .blade-run {
    position: absolute;
    inset: 0 0 auto 0;
    height: 140px;
    z-index: 5;
    overflow: hidden;
    pointer-events: none;
    animation: blade-life 1.3s linear forwards;
  }

  .blade-run .runner {
    position: absolute;
    left: 0;
    top: 10px;
    color: var(--ground-ink, #1b1a1c);
    filter: drop-shadow(-18px 0 0 color-mix(in srgb, currentColor 18%, transparent));
    animation: blade-dash 0.8s cubic-bezier(0.6, 0, 0.3, 1) forwards;
  }

  .blade-run .leg-a,
  .blade-run .leg-b {
    transform-box: fill-box;
    transform-origin: 50% 0;
    animation: blade-stride 0.16s ease-in-out infinite alternate;
  }

  .blade-run .leg-b {
    animation-direction: alternate-reverse;
  }

  .blade-run .sword {
    fill: var(--clover, #2fbf71);
    transform-box: fill-box;
    transform-origin: 0 50%;
    animation: blade-swing 0.3s 0.62s cubic-bezier(0.2, 0.9, 0.3, 1) both;
  }

  .blade-run .cut {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .blade-run .cut path {
    fill: none;
    stroke: var(--clover, #2fbf71);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    filter: drop-shadow(0 0 6px var(--clover, #2fbf71));
    animation: blade-cut 0.55s 0.6s cubic-bezier(0.7, 0, 0.2, 1) forwards;
  }

  @keyframes blade-dash {
    0% { transform: translateX(-140px) skewX(-8deg); }
    100% { transform: translateX(calc(100vw + 40px)) skewX(-8deg); }
  }

  @keyframes blade-stride {
    from { rotate: -22deg; }
    to { rotate: 22deg; }
  }

  @keyframes blade-swing {
    from { rotate: -70deg; }
    to { rotate: 80deg; }
  }

  @keyframes blade-cut {
    0% { stroke-dashoffset: 1; opacity: 1; }
    60% { stroke-dashoffset: 0; opacity: 1; }
    100% { stroke-dashoffset: 0; opacity: 0; }
  }

  @keyframes blade-life {
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Clover decals bob and sway like stickers in the breeze. */
    .decal {
      animation: decal-float 5s ease-in-out infinite;
    }

    @keyframes decal-float {
      0%, 100% { translate: 0 0; rotate: 0deg; }
      50% { translate: 0 -8px; rotate: 6deg; }
    }

    /* Cards and windows lift; screenshots zoom gently behind the glass. */
    .stop .shot,
    .stop .sign,
    .services .group,
    .refs .ref,
    .btn {
      transition: translate 0.3s ease, box-shadow 0.3s ease;
    }

    .stop .shot:hover,
    .stop .sign:hover,
    .refs .ref:hover,
    .btn:hover {
      translate: 0 -4px;
    }

    .stop .shot img {
      transition: scale 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .stop:hover .shot img {
      scale: 1.04;
    }

    .articles a {
      transition: padding 0.3s ease, color 0.3s ease;
    }

    .articles a:hover {
      padding-left: 0.75rem;
    }
  }
</style>
