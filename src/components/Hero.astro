---
// The first stop: the name painted on the body, the two calls (email, CV), the photo in a window with the
// back-window sticker, and the burgundy livery band carrying the roles ("Lead developer of SeeBlu").
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Clover from './Clover.astro';
import { faEnvelope } from '@fortawesome/free-solid-svg-icons';
import photo from '../images/profile.jpg';
import profile from '../data/profile.json';
import { socialIcon } from '../lib/socials.js';
import { titlesOf, projectUrl } from '../lib/projects.js';
import { url } from '../lib/url.js';

const { projects } = Astro.props;
const titles = titlesOf(projects);
---
<section class="hero" data-stop="home" aria-labelledby="hero-title">
  <div class="container body">
    <div class="copy">
      <h1 id="hero-title" class="paint">{profile.name}</h1>
      <p class="role">{profile.role}.</p>
      <p class="intro">{profile.intro}</p>
      <div class="calls">
        <a class="btn" href={`mailto:${profile.email}`}><Icon icon={faEnvelope} /> Email me</a>
        <a class="btn btn-line" href={url(profile.cv)} download><Clover size="1.15em" /> Download CV</a>
      </div>
      <ul class="socials" aria-label="Find me online">
        {profile.socials.map((social) => (
          <li>
            <a href={social.url} target="_blank" rel="noopener me"><Icon icon={socialIcon(social.network)} /><span>{social.label}</span></a>
          </li>
        ))}
      </ul>
    </div>

    <figure class="driver">
      <div class="glass">
        <Image src={photo} alt={`${profile.name}`} widths={[320, 480, 720]} sizes="(max-width: 860px) 60vw, 330px" loading="eager" fetchpriority="high" />
      </div>
      <figcaption class="vinyl">Surpass your limits. Right here, right now.</figcaption>
      <Clover class="decal" size="3.4rem" outline />
    </figure>
  </div>

  {titles.length > 0 && (
    <div class="band">
      <ul class="container slogans" aria-label="Roles">
        {titles.map(({ project, text }) => (
          <li>
            <Clover class="mark" size="1.15rem" />
            <a class="paint-plain" href={projectUrl(project)}>{text}</a>
          </li>
        ))}
      </ul>
    </div>
  )}
</section>

<style>
  .hero {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 21rem);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: end;
    padding-bottom: clamp(2.75rem, 5vw, 3.75rem);
  }

  h1 {
    font-size: clamp(3rem, 8.6vw, 6rem);
  }

  .role {
    margin-top: 1.4rem;
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .intro {
    max-width: 38rem;
    margin-top: 0.8rem;
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .calls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.9rem;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.2rem;
    margin-top: 1.5rem;
    list-style: none;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ground-muted);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }

  .socials a:hover {
    color: var(--ground-ink);
    text-decoration: underline;
  }

  /* The driver's window: photo behind glass, the motto as white vinyl on the lower rim, a clover decal stuck on. */
  .driver {
    position: relative;
    margin: 0;
    padding: 0.6rem 0.6rem 0;
    border-radius: 22px 22px 14px 14px;
    background: var(--window);
    box-shadow: 0 26px 44px -30px rgb(0 0 0 / 0.75);
  }

  .glass {
    overflow: hidden;
    border-radius: 15px 15px 6px 6px;
  }

  .glass img {
    width: 100%;
    aspect-ratio: 4 / 4.6;
    object-fit: cover;
    object-position: 50% 20%;
  }

  .vinyl {
    padding: 0.85rem 0.6rem 1rem;
    color: #ffffff;
    font-weight: 700;
    font-size: clamp(1rem, 1.6vw, 1.12rem);
    line-height: 1.25;
    text-align: center;
    transform: rotate(-2deg);
  }

  .driver :global(.decal) {
    position: absolute;
    top: -1.3rem;
    right: -1.1rem;
    color: var(--clover);
    transform: rotate(14deg);
    filter: drop-shadow(0 4px 6px rgb(0 0 0 / 0.3));
  }

  /* The livery band: roles painted on like bus slogans. */
  .band {
    background: var(--band);
    color: var(--band-ink);
    box-shadow: 0 calc(var(--stripe) / -1.5) 0 0 var(--ground), 0 calc(var(--stripe) / -1) 0 0 var(--band);
  }

  .slogans {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem clamp(1.5rem, 4vw, 3rem);
    padding-block: 1.25rem;
    list-style: none;
  }

  .slogans li {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .slogans :global(.mark) {
    color: var(--band-ink);
    opacity: 0.8;
  }

  .slogans a {
    color: inherit;
    font-size: clamp(1.05rem, 2.2vw, 1.45rem);
    line-height: 1.2;
    text-decoration: none;
  }

  .slogans a:hover {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.25em;
  }

  /* Phones: name, calls, then the roles band inside the first screen; the photo window follows it. */
  @media (max-width: 860px) {
    .hero {
      display: flex;
      flex-direction: column;
    }

    .body {
      display: contents;
    }

    .copy,
    .driver {
      width: min(100% - 2 * var(--gutter), 1160px);
      margin-inline: auto;
    }

    .copy {
      order: 1;
      padding-bottom: 2rem;
    }

    .band {
      order: 2;
    }

    .driver {
      order: 3;
      width: min(100% - 2 * var(--gutter), 17rem);
      margin: 2.75rem auto 0.5rem var(--gutter);
    }

    .slogans {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.45rem;
      padding-block: 1rem;
    }
  }
</style>
