---
// The tools, as a signwriter's services board: one painted board, one column per group (src/data/stack.json).
import stack from '../data/stack.json';
---
<section class="section" id="stack" data-stop="stack" aria-labelledby="stack-title">
  <div class="container">
    <div class="section-sign">
      <div>
        <h2 id="stack-title" class="paint">Tools of the trade</h2>
        <p>From the database to the browser to the server it runs on.</p>
      </div>
    </div>
    <div class="board services">
      {stack.groups.map((group) => (
        <div class="group">
          <h3 class="board-caps">{group.name}</h3>
          <ul>
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }

  .group {
    position: relative;
    padding: 1.6rem 1.7rem 1.8rem;
  }

  /* Painted dividers between the columns (and rows once they wrap). */
  .group + .group::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.4rem;
    bottom: 1.4rem;
    width: 2px;
    background: var(--board-ink);
    opacity: 0.18;
  }

  h3 {
    display: inline-block;
    margin-bottom: 1rem;
    padding: 0.3rem 0.65rem;
    background: var(--band);
    color: var(--band-ink);
    font-size: 0.85rem;
  }

  ul {
    display: grid;
    gap: 0.45rem;
    list-style: none;
  }

  li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 1.04rem;
    font-weight: 600;
  }

  li::before {
    content: '';
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 1px;
    background: var(--shade);
    transform: translateY(-0.12em) rotate(45deg);
  }

  @media (max-width: 640px) {
    .group + .group::before {
      left: 1.6rem;
      right: 1.6rem;
      top: 0;
      bottom: auto;
      width: auto;
      height: 2px;
    }
  }
</style>
